{
  "name": "blaze-frontend",
  "version": "1.13.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest --no-watch",
    "test:unit-watch": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/dom-view-transitions": "1.0.6",
    "@types/fhir": "0.0.44",
    "@types/humanize-duration": "3.27.4",
    "@types/node": "26.6.6",
    "change-case": "5.4.4",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "humanize-duration": "3.35.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "pretty-bytes": "7.2.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/lexend": "^5.0.0",
    "better-auth": "1.7.18",
    "svelte-heros-v2": "^3.0.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
