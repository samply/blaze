// The metadata the ShareableCodeSystem profile requires besides the
// description, which each code system states itself. The codes of all code
// systems of Blaze are case sensitive.
RuleSet: ShareableCodeSystem
* ^status = #active
* ^experimental = false
* ^caseSensitive = true

// The metadata the ShareableValueSet profile requires besides the description,
// which each value set states itself.
RuleSet: ShareableValueSet
* ^status = #active
* ^experimental = false
