{:deps
 {blaze/async
  {:local/root "../async"}

  blaze/db
  {:local/root "../db"}

  blaze/fhir-structure
  {:local/root "../fhir-structure"}

  blaze/job-util
  {:local/root "../job-util"}

  blaze/page-id-cipher
  {:local/root "../page-id-cipher"}

  buddy/buddy-core
  {:mvn/version "1.12.0-430"}

  ;; newer version for buddy-core dependency
  cheshire/cheshire
  {:mvn/version "6.2.0"}

  ;; newer version for cheshire dependency
  com.fasterxml.jackson.dataformat/jackson-dataformat-cbor
  {:mvn/version "2.22.4"}

  ;; newer version for cheshire dependency
  com.fasterxml.jackson.dataformat/jackson-dataformat-smile
  {:mvn/version "2.22.4"}

  ;; pinned to fix CVE-2025-8916 and CVE-2026-5588, can be removed if buddy-core
  ;; depends on at least this version
  org.bouncycastle/bcpkix-jdk18on
  {:mvn/version "1.86"}

  ;; pinned to fix CVE-2025-14813, CVE-2026-0636, CVE-2026-8763 and
  ;; CVE-2026-13506, can be removed if buddy-core depends on at least this
  ;; version
  org.bouncycastle/bcprov-jdk18on
  {:mvn/version "1.86"}

  org.apache.httpcomponents.core5/httpcore5
  {:mvn/version "5.4.4"}

  metosin/reitit-ring
  {:mvn/version "0.11.0"
   :exclusions [ring/ring-core]}

  metosin/muuntaja
  {:mvn/version "0.6.12"
   :exclusions [javax.xml.bind/jaxb-api]}

  ring/ring-core
  {:mvn/version "1.15.6"
   :exclusions
   [crypto-equality/crypto-equality
    crypto-random/crypto-random
    org.apache.commons/commons-fileupload2-core]}}

 :aliases
 {:test
  {:extra-paths ["test"]

   :extra-deps
   {blaze/db-stub
    {:local/root "../db-stub"}}}

  :kaocha
  {:extra-deps
   {lambdaisland/kaocha
    {:mvn/version "1.91.1392"}}

   :main-opts ["-m" "kaocha.runner"]}

  :coverage
  {:extra-deps
   {lambdaisland/kaocha-cloverage
    {:mvn/version "1.1.89"}}

   :main-opts ["-m" "kaocha.runner" "--profile" "coverage"]}}}
