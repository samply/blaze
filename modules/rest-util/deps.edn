{:deps
 {blaze/async
  {:local/root "../async"}

  blaze/db
  {:local/root "../db"}

  blaze/fhir-structure
  {:local/root "../fhir-structure"}

  blaze/job-util
  {:local/root "../job-util"}

  blaze/page-id-cipher
  {:local/root "../page-id-cipher"}

  buddy/buddy-auth
  {:mvn/version "3.0.323"
   :exclusions [buddy/buddy-sign]}

  org.apache.httpcomponents.core5/httpcore5
  {:mvn/version "5.4.4"}

  metosin/reitit-ring
  {:mvn/version "0.11.0"
   :exclusions [ring/ring-core]}

  metosin/muuntaja
  {:mvn/version "0.6.12"
   :exclusions [javax.xml.bind/jaxb-api]}

  ring/ring-core
  {:mvn/version "1.15.6"
   :exclusions
   [crypto-equality/crypto-equality
    crypto-random/crypto-random
    org.apache.commons/commons-fileupload2-core]}}

 :aliases
 {:test
  {:extra-paths ["test"]

   :extra-deps
   {blaze/db-stub
    {:local/root "../db-stub"}}}

  :kaocha
  {:extra-deps
   {lambdaisland/kaocha
    {:mvn/version "1.91.1392"}}

   :main-opts ["-m" "kaocha.runner"]}

  :coverage
  {:extra-deps
   {lambdaisland/kaocha-cloverage
    {:mvn/version "1.1.89"}}

   :main-opts ["-m" "kaocha.runner" "--profile" "coverage"]}}}
