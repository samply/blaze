{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchDatasources": [
        "npm", "docker"
      ],
      "schedule": [
        "before 4am on monday"
      ]
    },
    {
      "description": [
        "Renovate resolves npm registries from a global npmrc state that concurrent lookups share, so the unscoped registry in modules/frontend-e2e/test-data/.npmrc can leak into unrelated lookups (e.g. prettier) and fail them with no-result. Pin every npm dependency to an explicit registry to bypass npmrc-based resolution; later rules override this default for package files served from other registries."
      ],
      "matchDatasources": [
        "npm"
      ],
      "registryUrls": [
        "https://registry.npmjs.org"
      ]
    },
    {
      "matchFileNames": [
        "modules/frontend-e2e/test-data/**"
      ],
      "registryUrls": [
        "https://packages.simplifier.net"
      ]
    },
    {
      "matchFileNames": [
        ".github/value-set-expand/**"
      ],
      "registryUrls": [
        "https://gitlab.com/api/v4/packages/npm/"
      ]
    },
    {
      "groupName": "jackson",
      "matchPackageNames": [
        "/com.fasterxml.jackson/"
      ]
    },
    {
      "groupName": "cqframework",
      "matchPackageNames": [
        "/info.cqframework/"
      ]
    },
    {
      "groupName": "hapi-fhir",
      "matchPackageNames": [
        "ca.uhn.hapi.fhir:hapi-fhir*"
      ]
    },
    {
      "groupName": "hl7-fhir",
      "matchPackageNames": [
        "ca.uhn.hapi.fhir:org.hl7.fhir*"
      ]
    },
    {
      "groupName": "reitit",
      "matchPackageNames": [
        "/reitit/"
      ]
    },
    {
      "groupName": "ring",
      "matchPackageNames": [
        "/ring/"
      ]
    },
    {
      "groupName": "systems.uom",
      "matchPackageNames": [
        "/systems.uom/"
      ]
    }
  ],
  "customManagers": [
    {
      "description": [
        "Like customManagers:githubActionsVersions, but also finds the digest for github-release-attachments datasource."
      ],
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "datasourceTemplate": "github-release-attachments",
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=(?<depName>\\S+?)(?: (?:lookupName|packageName)=(?<packageName>\\S+?))?(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+\\w+?_VERSION\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s+(\\w+?_CHECKSUM\\s*:\\s*[\"']?(?<currentDigest>\\w+)[\"']?)?"
      ]
    },
    {
      "description": [
        "Keep the toolchain versions pinned in the Claude Code SessionStart hook up to date."
      ],
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.claude/hooks/session-start\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+\\w+_VERSION=\"(?<currentValue>.+?)\""
      ]
    }
  ],
  "ignorePaths": [
    "docs"
  ],
  "prConcurrentLimit": 3
}
